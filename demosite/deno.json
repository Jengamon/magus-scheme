{
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno run -A npm:vite",
    "build": "deno run -A npm:vite build"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "solid-js": "npm:solid-js@^1.9.6",
    "vite": "npm:vite@^6.3.5",
    "vite-plugin-solid": "npm:vite-plugin-solid@^2.11.6"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "solid-js",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ]
  }
}