---
; allow spaces in abbreviations
ROOT@0..25
  DATUM@0..24
    ABBREV@0..24
      ABBREV_SYM@0..1 "`"
      DATUM@1..24
        LIST@1..24
          LPAREN@1..2 "("
          DATUM@2..6
            SYMBOL@2..6 "list"
          WHITESPACE@6..7 " "
          DATUM@7..14
            ABBREV@7..14
              ABBREV_SYM@7..8 ","
              WHITESPACE@8..9 " "
              DATUM@9..14
                SYMBOL@9..14 "@name"
          WHITESPACE@14..15 " "
          DATUM@15..23
            ABBREV@15..23
              ABBREV_SYM@15..16 "'"
              DATUM@16..23
                ABBREV@16..23
                  ABBREV_SYM@16..17 ","
                  WHITESPACE@17..18 " "
                  DATUM@18..23
                    SYMBOL@18..23 "@name"
          RPAREN@23..24 ")"
  LINEEND@24..25 "\n"
---
`(list , @name ', @name)
